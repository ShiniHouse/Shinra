# --- Ambiente virtuale ---
.venv/
venv/
ENV/
env/

# --- Cache Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Strumenti di sviluppo ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- IDE ed editor ---
.vscode/
.idea/
*.swp
*.swo

# --- File di sistema ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Log ---
*.log
logs/

# =========================================================================
#  SEGRETI E STATO LOCALE — non devono mai finire su GitHub
# =========================================================================
# config.yaml riceve il token di Home Assistant e il PIN amministratore
# quando vengono salvati dall'interfaccia (config/settings.py -> save_config).
# Il file di riferimento versionato e' config/config.example.yaml.
config/config.yaml
.env
*.pem
*.key

# Stato runtime: contiene i nomi della famiglia, le abitudini della casa e
# gli alias dei dispositivi reali. Non ha alcun motivo di essere versionato.
# I valori iniziali vivono in data/examples/, che invece e' versionato: al
# primo avvio ogni file mancante viene creato copiando il proprio esempio.
data/*.json
data/*.db
data/*.sqlite3
!data/examples/
!data/examples/*.json
