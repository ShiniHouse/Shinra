# ---------------------------------------------------------------------------
# Shinra — variabili d'ambiente
#
# Da v0.1.0 i segreti si leggono da qui (o dall'ambiente di sistema) e non
# piu' da config/config.yaml, che resta per le sole opzioni non sensibili.
# Copiare in .env e compilare. Il file .env NON e' versionato.
# ---------------------------------------------------------------------------

# Token a lungo termine di Home Assistant
# (Profilo utente -> Sicurezza -> Token di accesso a lungo termine)
SHINRA_HA_TOKEN=

# URL dell'istanza Home Assistant
SHINRA_HA_URL=http://homeassistant.local:8123

# PIN amministratore in chiaro SOLO al primo avvio: viene sostituito
# dal proprio hash al primo salvataggio delle impostazioni.
SHINRA_ADMIN_PIN=

# Segreto per la firma dei token di sessione. Generare con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SHINRA_SESSION_SECRET=

# Application ID della skill Alexa (amzn1.ask.skill.xxxxxxxx).
# Obbligatorio se l'endpoint /api/alexa e' esposto su Internet.
SHINRA_ALEXA_SKILL_ID=

# URL di Ollama
SHINRA_OLLAMA_URL=http://localhost:11434

# Indirizzi dei reverse proxy di cui fidarsi per leggere X-Forwarded-For.
# Serve solo se Shinra sta dietro nginx o Cloudflare: senza, la limitazione
# dei tentativi di accesso vede tutti come lo stesso client, e il quinto
# tentativo sbagliato di uno sconosciuto blocca il proprietario di casa.
# Si imposta in config/config.yaml sotto security.trusted_proxies.
